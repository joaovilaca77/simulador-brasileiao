{
  "name": "liga-draft-cartola",
  "version": "1.0.0",
  "private": true,
  "description": "Draft ao vivo de uma liga baseada no Cartola FC.",
  "type": "module",
  "scripts": {
    "dev": "npx --yes serve -l 3000 .",
    "atletas": "node scripts/atualizar-atletas.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "versionar": "node scripts/versionar.mjs",
    "test:regras": "firebase emulators:exec --only firestore --project demo-liga \"node --test tests/regras/\""
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0"
  }
}
